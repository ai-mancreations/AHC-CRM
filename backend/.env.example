ENV=development

# MongoDB - use your Atlas connection string in production, or the local
# docker-compose "mongo" service for local dev (mongodb://mongo:27017)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=american_hair_club

# JWT
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14

# Fernet key for encrypting integration credentials at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-generated-fernet-key

# Cloudinary (file storage for invoice PDFs, staff photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# GST / financial year
FY_START_MONTH=4
